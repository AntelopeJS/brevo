{
  "name": "brevo-playground",
  "version": "1.0.0",
  "description": "Brevo playground module for testing and development",
  "author": "Glastis",
  "license": "MIT",
  "logging": {
    "channelFilter": {
      "*": "INFO"
    }
  },
  "modules": {
    "brevo": {
      "source": {
        "type": "local",
        "path": "..",
        "installCommand": ["pnpm i", "npx tsc"]
      },
      "config": {
        "apiKey": "",
        "defaultSender": {
          "email": "email-playground@antelopejs.com",
          "name": "AntelopeJS"
        }
      }
    },
    "playground": {
      "source": {
        "type": "local",
        "path": ".",
        "installCommand": ["pnpm i", "npx tsc"]
      }
    }
  },
  "envOverrides": {
    "BREVO_API_KEY": "modules.brevo.config.apiKey"
  }
}
