{
  "name": "@antelopejs/brevo",
  "version": "0.0.5",
  "description": "A Brevo (Sendinblue) email module that implements the email interface of AntelopeJS",
  "keywords": [
    "antelopejs",
    "brevo",
    "email",
    "mail",
    "newsletter"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AntelopeJS/brevo.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "dotenv -- ajs project run -w -p playground",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && dotenv -- ajs module test .",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.0.6 <1.0.0",
    "@antelopejs/interface-email": ">=0.0.4 <1.0.0",
    "axios": "^1.13.6"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/sinon": "^17.0.4",
    "dotenv-cli": "^11.0.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "sinon": "^20.0.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-email"
    ],
    "test": "src/test/antelope.test.ts"
  }
}
