{
  "name": "@antelopejs/brevo",
  "version": "0.0.1",
  "description": "A Brevo (Sendinblue) email module that implements the email interface of AntelopeJS",
  "repository": {
    "type": "git",
    "url": "https://github.com/AntelopeJS/brevo.git"
  },
  "keywords": [
    "antelopejs",
    "brevo",
    "email",
    "mail",
    "newsletter"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "dotenv -- ajs project run -w -p playground",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "lint": "biome check .",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && dotenv -- ajs module test ."
  },
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-email"
    ],
    "test": "src/test/antelope.test.ts"
  },
  "dependencies": {
    "@antelopejs/interface-core": "^0.0.2",
    "@antelopejs/interface-email": "^0.0.2",
    "axios": "^1.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.18",
    "@types/sinon": "^17.0.4",
    "chai": "^5.2.0",
    "dotenv-cli": "^11.0.0",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "sinon": "^20.0.0",
    "typescript": "^5.8.3",
    "rimraf": "^6.0.1"
  }
}
