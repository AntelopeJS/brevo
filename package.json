{
  "name": "@antelopejs/brevo",
  "version": "0.1.0",
  "description": "A flexible email module that implements the brevo interface of antelopejs",
  "repository": {
    "type": "git",
    "url": "https://github.com/AntelopeJS/brevo.git"
  },
  "keywords": [
    "antelopejs",
    "brevo",
    "email",
    "mail",
    "newsletter"
  ],
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "tsc",
    "dev:prepare": "cd playground && ajs module imports install",
    "dev": "dotenv -- ajs project run -w -p playground",
    "format": "biome format --write .",
    "generate": "ajs module exports generate",
    "lint:fix": "biome check --write .",
    "lint": "biome check .",
    "prepack": "pnpm run build",
    "prepare": "ajs module imports install",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -- ajs module test ."
  },
  "antelopeJs": {
    "exportsPath": "dist/interfaces",
    "imports": [
      "core@beta",
      "logging@beta"
    ],
    "importsOptional": [],
    "test": {
      "project": "src/test/antelope.test.json",
      "folder": "dist/test"
    }
  },
  "dependencies": {
    "axios": "^1.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.18",
    "@types/sinon": "^17.0.4",
    "chai": "^5.2.0",
    "dotenv-cli": "^11.0.0",
    "release-it": "^19.0.2",
    "sinon": "^20.0.0",
    "typescript": "^5.8.3"
  }
}
